# Copy to backend/.env and fill in. That file is gitignored — never commit it.
#
# The LLM is optional by design. With no key, POST /api/query still answers using
# keyword retrieval and reports `answered_by: "keyword"`; with a key it uses Groq
# and reports the model. Nothing else changes, and nothing errors — which is why
# a missing key is easy to miss.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Local development only. Production runs single-origin behind nginx, so compose
# sets this to [] and no cross-origin request is ever made.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]

# Defaults to <repo>/backend/data/app.db locally; compose overrides it to the
# named volume at /srv/data/app.db.
# DATABASE_URL=sqlite:////srv/data/app.db
