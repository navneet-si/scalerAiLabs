# Copy to frontend/.env.local for local development.
#
# In production this is NOT set here — it is baked into the browser bundle at
# image build time via the Dockerfile's NEXT_PUBLIC_API_BASE build arg (set to
# `/api` by docker-compose). Setting it at runtime has no effect: `next build`
# inlines NEXT_PUBLIC_* into the client JS.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
